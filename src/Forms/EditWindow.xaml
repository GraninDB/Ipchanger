<Window x:Class="IPChanger.Forms.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit preset"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LabelName" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LabelIp" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="IpBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LabelMask" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="MaskBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" x:Name="LabelGateway" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="GatewayBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="LabelPrimaryDns" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="PrimaryDnsBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" x:Name="LabelSecondaryDns" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox x:Name="SecondaryDnsBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
