<Window x:Class="IPChanger.Forms.ApplyStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApplyStatusWindow"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="StepsList" Grid.Row="0" Width="350" Height="120"
                 Margin="0,10,0,0"
                 BorderBrush="LightGray" BorderThickness="1"
                 FontSize="12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <Button x:Name="OkButton" Grid.Row="1" Width="75" Height="23"
                Content="OK" Margin="0,15,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="OkButton_Click" />
    </Grid>
</Window>
